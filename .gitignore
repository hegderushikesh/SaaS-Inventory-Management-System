# ==============================================================================
# StockFlow SaaS - Root .gitignore
# ==============================================================================

# Security: Environment variables and sensitive secrets (NEVER commit to GitHub)
.env
.env.*
*.env
!.env.example
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Subdirectory environment files
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Node dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Production build outputs
dist/
dist-ssr/
frontend/dist/
build/

# Logs and error reports
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor and IDE configurations
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Testing and coverage reports
coverage/
.nyc_output/
*.lcov

# Temporary and cache directories
.cache/
.parcel-cache/
.eslintcache
*.tmp
